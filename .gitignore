# byte-compiled / build
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.eggs/

# environments (kept outside the tree, but guard anyway)
.venv/
venv/

# pixi working directory - environments, task cache and the local
# detached-environments config. The environments themselves live under
# C:/python-environments/pixi/envs. pixi.lock itself IS tracked.
.pixi/

# test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
coverage-reports/
htmlcov/
junit.xml

# docs build
site/

# notebooks
.ipynb_checkpoints/
.jupyter_cache/

# project memory - never commit (see repo CLAUDE.md policy)
CLAUDE.md

# IDE
.idea/
.vscode/
# pixi environments
.pixi/*
!.pixi/config.toml
